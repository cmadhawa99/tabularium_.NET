<Window x:Class="ArchivumWpf.Views.ConnectionSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        Title="Database Connection Setup" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        TextElement.FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    <Grid Margin="32">
        <StackPanel>
            <fa:ImageAwesome Icon="Cog" Width="36" Height="36" Foreground="{DynamicResource PrimaryAccent}"
                             HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="Database Connection Setup" Foreground="{DynamicResource TextMain}" FontSize="20"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,28">
                Create a brand-new empty database, attach an existing populated database, or manage your saved connections.
            </TextBlock>

            <Button Content="Connect New Empty Database"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding OpenNewDatabaseWizardCommand}"
                    Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}"
                    BorderThickness="0" Cursor="Hand" Padding="0,14" Margin="0,0,0,14">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <fa:ImageAwesome Icon="Database" Width="14" Height="14" Margin="0,0,10,0"
                                                 Foreground="{DynamicResource WindowBackground}" />
                                <TextBlock Text="{TemplateBinding Content}" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Connect Existing Database"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding OpenConnectExistingDatabaseCommand}"
                    Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextMain}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" Padding="0,14"
                    Margin="0,0,0,14">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <fa:ImageAwesome Icon="Plug" Width="14" Height="14" Margin="0,0,10,0"
                                                 Foreground="{DynamicResource TextMain}" />
                                <TextBlock Text="{TemplateBinding Content}" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Manage Connections"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding OpenConnectionManagerCommand}"
                    Background="Transparent" Foreground="{DynamicResource TextMuted}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand" Padding="0,12">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <fa:ImageAwesome Icon="ListUl" Width="13" Height="13" Margin="0,0,10,0"
                                                 Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{TemplateBinding Content}" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>