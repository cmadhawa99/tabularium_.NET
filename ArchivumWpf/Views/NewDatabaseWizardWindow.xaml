<Window x:Class="ArchivumWpf.Views.NewDatabaseWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ArchivumWpf.Converters"
        Title="Connect a New Empty Database" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    
    <Window.Resources>
        <converters:StepEqualsConverter x:Key="StepEqualsConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
    </Window.Resources>

    <Grid Margin="28">
        <StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerAccent}"
                       TextWrapping="Wrap" Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
            <!-- STEP 1: Encryption Key -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=1}">
                <TextBlock Text="Step 1 of 5 — Encryption Key" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>
                <TextBlock Text="Provide an AES-256-GCM key (Base64), or generate a random one." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBox Text="{Binding EncryptionKeyInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="10" Margin="0,0,0,12"/>
                <Button Content="Generate Random Key" Command="{Binding GenerateKeyCommand}" HorizontalAlignment="Left" Padding="16,8" Margin="0,0,0,20"/>
                <Button Content="Next" Command="{Binding NextFromKeyStepCommand}" HorizontalAlignment="Right" Padding="24,10"
                        Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"/>
            </StackPanel>

            <!-- STEP 2: Database connection -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=2}">
                <TextBlock Text="Step 2 of 5 — Empty Database Connection" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>
                <TextBlock Text="Point to a PostgreSQL database with no existing tables." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="Host"/>
                <TextBox Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,4,0,12"/>
                <TextBlock Text="Database Name"/>
                <TextBox Text="{Binding DbName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,4,0,12"/>
                <TextBlock Text="Username"/>
                <TextBox Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,4,0,12"/>
                <TextBlock Text="Password"/>
                <PasswordBox x:Name="DbPasswordBox" PasswordChanged="DbPasswordBox_PasswordChanged" Padding="10" Margin="0,4,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,12,0" Padding="20,10"/>
                    <Button Content="Test &amp; Next" Command="{Binding NextFromDbStepCommand}" Padding="24,10"
                            Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- STEP 3: Secure storage location -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=3}">
                <TextBlock Text="Step 3 of 5 — Secure File Storage" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>
                <TextBlock Text="Choose where encrypted documents will be stored. The folder will be created hidden." Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding StorageParentDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseStorageDirectoryCommand}" Padding="16,10"/>
                </Grid>
                <TextBlock Text="Folder name"/>
                <TextBox Text="{Binding StorageFolderName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,4,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,12,0" Padding="20,10"/>
                    <Button Content="Next" Command="{Binding NextFromStorageStepCommand}" Padding="24,10"
                            Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- STEP 4: Admin account -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=4}">
                <TextBlock Text="Step 4 of 5 — Admin Account" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>
                <TextBlock Text="Username"/>
                <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,4,0,12"/>
                <TextBlock Text="Password"/>
                <PasswordBox x:Name="AdminPasswordBox" PasswordChanged="AdminPasswordBox_PasswordChanged" Padding="10" Margin="0,4,0,12"/>
                <TextBlock Text="Confirm Password"/>
                <PasswordBox x:Name="AdminPasswordConfirmBox" PasswordChanged="AdminPasswordConfirmBox_PasswordChanged" Padding="10" Margin="0,4,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,12,0" Padding="20,10"/>
                    <Button Content="Next" Command="{Binding NextFromAdminStepCommand}" Padding="24,10"
                            Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- STEP 5: Review & Create -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=5}">
                <TextBlock Text="Step 5 of 5 — Review &amp; Create" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,20">
                    This will save your encryption key, connect to the database, run the initial schema migration,
                    create your secure storage folder, and create your admin account. This cannot be easily undone.
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,12,0" Padding="20,10"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="Create Database Connection"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Command="{Binding FinishSetupCommand}" Padding="24,10"
                            Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>