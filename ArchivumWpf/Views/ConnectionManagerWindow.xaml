<Window x:Class="ArchivumWpf.Views.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Database Connections" Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select or manage saved database connections" FontSize="16"
                   Foreground="{DynamicResource PrimaryAccent}" Margin="0,0,0,16"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}"
                  Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextMain}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat='Created {0:yyyy-MM-dd}'}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Remove"
                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" Padding="12,6"
                                Background="Transparent" BorderBrush="{DynamicResource DangerAccent}" BorderThickness="1"
                                Foreground="{DynamicResource DangerAccent}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,12,0" Padding="20,10"/>
            <Button Content="Connect"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding ConnectCommand}" Padding="24,10"
                    Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>