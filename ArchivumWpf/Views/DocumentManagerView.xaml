<UserControl x:Class="ArchivumWpf.Views.DocumentManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             AllowDrop="True" Drop="UserControl_Drop"
             xmlns:converters="clr-namespace:ArchivumWpf.Converters"
             Background="{DynamicResource WindowBackground}"
             TextElement.FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- RR Number and Name strip -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding RecordTitle}" Foreground="{DynamicResource PrimaryAccent}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Command="{Binding ImportFilesCommand}" Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource CardBackground}" BorderThickness="0" Cursor="Hand" Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                    <fa:ImageAwesome Icon="CloudUpload" Width="12" Height="12" Margin="0,0,8,0" Foreground="{DynamicResource CardBackground}"/>
                                    <TextBlock Text="Import Files" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="20,10">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontSize="12"/>
        </Border>

        <!-- Document icons grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20">
            <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="120" Margin="0,0,16,16" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel HorizontalAlignment="Center">
                                <Button Command="{Binding DataContext.ViewDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="{Binding OriginalFileName}">
                                    <StackPanel>
                                        <fa:ImageAwesome Icon="FileTextOutline" Width="36" Height="36" Foreground="{DynamicResource PrimaryAccent}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding OriginalFileName}" FontSize="11" Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Width="96"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Export" FontSize="10" Margin="0,8,0,0" Padding="8,4"
                                        Command="{Binding DataContext.ExportDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        Foreground="{DynamicResource TextMuted}" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Zero-disk-footprint image preview -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#DD000000"
              Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisConverter}}"
              Focusable="True" KeyDown="PreviewOverlay_KeyDown">
            <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Margin="40"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding PreviewFileName}" FontSize="14" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>

                            <!-- PDF-only controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"
                                        Visibility="{Binding IsPdfMode, Converter={StaticResource BoolToVisConverter}}">
                                <Button Command="{Binding PreviousPdfPageCommand}" Content="◀" Padding="10,4" Margin="0,0,8,0" Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Foreground="{DynamicResource TextMain}" Cursor="Hand"/>
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMain}" Margin="0,0,8,0">
                                    <Run Text="{Binding PdfCurrentPage, Mode=OneWay}"/> / <Run Text="{Binding PdfTotalPages, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Command="{Binding NextPdfPageCommand}" Content="▶" Padding="10,4" Margin="0,0,16,0" Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Foreground="{DynamicResource TextMain}" Cursor="Hand"/>

                                <Button Command="{Binding ZoomOutPdfCommand}" Content="－" Padding="10,4" Margin="0,0,4,0" Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Foreground="{DynamicResource TextMain}" Cursor="Hand"/>
                                <TextBlock Text="{Binding PdfZoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Width="50" TextAlignment="Center"/>
                                <Button Command="{Binding ZoomInPdfCommand}" Content="＋" Padding="10,4" Background="Transparent" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Foreground="{DynamicResource TextMain}" Cursor="Hand"/>
                            </StackPanel>

                            <Button Grid.Column="2" Content="✕" Command="{Binding ClosePreviewCommand}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryAccent}" FontSize="16" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" MinWidth="0" MaxWidth="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail rail (PDF only) -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsPdfMode, Converter={StaticResource BoolToVisConverter}}"
                                      Background="{DynamicResource WindowBackground}">
                            <ItemsControl ItemsSource="{Binding PdfThumbnails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.JumpToPdfPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Image Source="{Binding}" Stretch="Uniform"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Main page/image -->
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="700"
                                       Visibility="{Binding IsPdfMode, Converter={StaticResource InverseBoolToVis}}"/>
                                <Image Source="{Binding PdfPageImage}" Stretch="Uniform"
                                       Visibility="{Binding IsPdfMode, Converter={StaticResource BoolToVisConverter}}"/>
                                <TextBlock Text="Rendering..." Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsPdfLoading, Converter={StaticResource BoolToVisConverter}}"/>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>