<Window x:Class="ArchivumWpf.Views.ConnectExistingDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ArchivumWpf.Converters"
        Title="Connect an Existing Database" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <converters:StepEqualsConverter x:Key="StepEqualsConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter" />

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerAccent}"
                       TextWrapping="Wrap" Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
            
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=1}">
                <TextBlock Text="Step 1 of 4 — Original Encryption Key" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>
                <TextBlock Foreground="{DynamicResource DangerAccent}" TextWrapping="Wrap" Margin="0,0,0,12">
                    This must be the exact AES-256-GCM key this database was originally created with.
                    A generated or mismatched key will fail to decrypt its data.
                </TextBlock>
                <TextBox Text="{Binding EncryptionKeyInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="10" Margin="0,0,0,20"/>
                <Button Content="Next" Command="{Binding NextFromKeyStepCommand}" HorizontalAlignment="Right" Padding="24,10"
                        Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"/>
            </StackPanel>

            <!--  Database connection + validation -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=2}">
                <TextBlock Text="Step 2 of 4 — Existing Database Connection" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>
                <TextBlock Text="Point to the populated PostgreSQL database you want to attach. Its schema and the key above will be verified before continuing."
                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock Text="Host" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,12"/>
                <TextBlock Text="Database Name" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding DbName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,12"/>
                <TextBlock Text="Username" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,12"/>
                <TextBlock Text="Password" Style="{StaticResource FormLabel}"/>
                <PasswordBox x:Name="DbPasswordBox" PasswordChanged="DbPasswordBox_PasswordChanged" Padding="10" Margin="0,0,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,12,0" Padding="20,10"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="Validate &amp; Next" Command="{Binding ValidateAndNextFromDbStepCommand}" Padding="24,10"
                            Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </StackPanel>

            <!-- Secure storage location -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=3}">
                <TextBlock Text="Step 3 of 4 — Secure File Storage" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton Content="I have the original folder" GroupName="StorageMode"
                                 IsChecked="{Binding IsCreatingNewStorage, Converter={StaticResource InverseBoolConverter}}"
                                 Foreground="{DynamicResource TextMain}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <RadioButton Content="I don't have it anymore" GroupName="StorageMode"
                                 IsChecked="{Binding IsCreatingNewStorage}"
                                 Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- existing folder -->
                <StackPanel Visibility="{Binding IsCreatingNewStorage, Converter={StaticResource InverseBoolToVisConverter}}">
                    <TextBlock Text="Point to the (hidden) folder where this database's encrypted documents already live. It will not be modified."
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding StorageDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseStorageDirectoryCommand}" Padding="16,10"/>
                    </Grid>
                </StackPanel>

                <!--  original folder lost - create a new empty one -->
                <StackPanel Visibility="{Binding IsCreatingNewStorage, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Foreground="{DynamicResource DangerAccent}" TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold">
                        Warning: Previously attached documents will no longer be reachable if you create a new
                        folder. File records, RR numbers, and all history remain fully intact — only the actual
                        document files become unavailable. New documents you attach going forward will save here.
                    </TextBlock>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewStorageParentDirectory, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseNewStorageParentDirectoryCommand}" Padding="16,10"/>
                    </Grid>
                    <TextBlock Text="Folder name" Style="{StaticResource FormLabel}"/>
                    <TextBox Text="{Binding NewStorageFolderName, UpdateSourceTrigger=PropertyChanged}" Padding="10" Margin="0,0,0,20"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,12,0" Padding="20,10"/>
                    <Button Content="Next" Command="{Binding NextFromStorageStepCommand}" Padding="24,10"
                            Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- Review & Attach -->
            <StackPanel Visibility="{Binding CurrentStep, Converter={StaticResource StepEqualsConverter}, ConverterParameter=4}">
                <TextBlock Text="Step 4 of 4 — Review &amp; Attach" Foreground="{DynamicResource PrimaryAccent}" FontSize="18" Margin="0,0,0,12"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,20">
                    Schema and key have both been verified. This will save your key locally, register this
                    connection, and make it available to log in with your existing account. No data will be modified.
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Back" Command="{Binding BackCommand}" Margin="0,0,12,0" Padding="20,10"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>
                    <Button Content="Attach Existing Database"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Command="{Binding FinishSetupCommand}" Padding="24,10"
                            Background="{DynamicResource PrimaryAccent}" Foreground="{DynamicResource WindowBackground}" BorderThickness="0"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>