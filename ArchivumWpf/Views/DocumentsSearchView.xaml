<UserControl x:Class="ArchivumWpf.Views.DocumentsSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             Background="{DynamicResource WindowBackground}"
             xmlns:loc="clr-namespace:ArchivumWpf.Localization"
             TextElement.FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,20">
            <TextBlock Text="{x:Static loc:Strings.Doc_MainTitle}" Foreground="{DynamicResource PrimaryAccent}"
                       FontSize="20" />
        </Border>

        <!-- Search bar + button (Figure 1) -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="6" Margin="20,20,20,10" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMain}"
                         FontSize="14" VerticalContentAlignment="Center" Margin="8,6">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Command="{Binding SearchCommand}" Background="{DynamicResource PrimaryAccent}"
                        Foreground="{DynamicResource CardBackground}" BorderThickness="0" Padding="20,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                    <fa:ImageAwesome Icon="Search" Width="12" Height="12" Margin="0,0,8,0"
                                                     Foreground="{DynamicResource CardBackground}" />
                                    <TextBlock Text="Search" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- RR Number / Name list with scrollbar (Figure 1) -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="Transparent" Foreground="{DynamicResource TextMain}"
                  RowBackground="Transparent" AlternatingRowBackground="Transparent"
                  HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Margin="20,0,20,20">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static loc:Strings.Doc_ColRrNumber}" Binding="{Binding RrNumber}"
                                    Width="200" />
                <DataGridTextColumn Header="{x:Static loc:Strings.Doc_ColName}" Binding="{Binding FileName}" Width="*" />
                <DataGridTemplateColumn Header="{x:Static loc:Strings.Doc_ColActions}" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{x:Static loc:Strings.Doc_BtnManage}" Padding="12,4"
                                    Command="{Binding DataContext.OpenDocumentManagerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Background="{DynamicResource PrimaryAccent}"
                                    Foreground="{DynamicResource CardBackground}" BorderThickness="0" Cursor="Hand" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>